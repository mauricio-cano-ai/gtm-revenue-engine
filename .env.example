# Local API used by the n8n workflow.
GTM_SCORING_CONFIG=config/scoring.yaml
GTM_API_HOST=0.0.0.0
GTM_API_PORT=8000
GTM_ENGINE_SCORE_URL=http://localhost:8000/score
